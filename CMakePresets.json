{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "core-tests",
      "displayName": "Core tests only",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MASCOT_BUILD_PLUGIN": "OFF",
        "MASCOT_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "plugin-release",
      "displayName": "OBS plugin (release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/plugin-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MASCOT_BUILD_PLUGIN": "ON",
        "MASCOT_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core-tests",
      "configurePreset": "core-tests"
    },
    {
      "name": "plugin-release",
      "configurePreset": "plugin-release"
    }
  ],
  "testPresets": [
    {
      "name": "core-tests",
      "configurePreset": "core-tests",
      "output": { "outputOnFailure": true }
    }
  ]
}
